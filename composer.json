{
  "name": "milpa/notifications",
  "description": "Channel-agnostic notification dispatch for the Milpa PHP framework: register channels (Telegram, Pushover, WebSocket, ...) and fan a payload out to recipients by \"channel:recipient\".",
  "type": "library",
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "Rodrigo Vicente - TeamX Agency",
      "homepage": "https://teamx.agency"
    }
  ],
  "require": {
    "php": ">=8.3",
    "psr/log": "^3"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpdoc-parser": "^2.3",
    "friendsofphp/php-cs-fixer": "^3.65",
    "milpa/core": "^0.6"
  },
  "autoload": {
    "psr-4": {
      "Milpa\\Notifications\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Milpa\\Notifications\\Tests\\": "tests/",
      "Milpa\\Docs\\": "vendor/milpa/core/tools/gen-docs/"
    }
  }
}
